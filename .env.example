# poopuri storage — Cloudflare R2 (set these in the Vercel project, not here)
# Storage → your bucket → these come from the R2 dashboard + an R2 API token.

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-api-token-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-api-token-secret
R2_BUCKET=poopuri
# The bucket's PUBLIC url (enable the r2.dev public dev URL, or a custom domain).
# Example: https://pub-xxxxxxxxxxxxxxxx.r2.dev
R2_PUBLIC_BASE=https://pub-xxxxxxxxxxxxxxxx.r2.dev
